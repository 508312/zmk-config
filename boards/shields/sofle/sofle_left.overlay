#include <zephyr/dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 17)>, 
                    <NRF_PSEL(SPIM_MOSI, 0, 20)>, 
                    <NRF_PSEL(SPIM_MISO, 0, 25)>; 
        };
    };
};

&i2c0 {
    status = "disabled";
};

&spi1 {
    status = "disabled";
};

&kscan0 {
    row-gpios
        = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row 0
        , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row 1
        , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row 2
        , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row 3
        , <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>     // Rebound to Pin 017 (Example: Row 4)
        ;

    col-gpios
        = <&pro_micro 29 GPIO_ACTIVE_HIGH> // col 0
        , <&pro_micro 28 GPIO_ACTIVE_HIGH> // col 1
        , <&pro_micro 27 GPIO_ACTIVE_HIGH> // col 2
        , <&pro_micro 26 GPIO_ACTIVE_HIGH> // col 3
        , <&gpio0 20 GPIO_ACTIVE_HIGH>     // Rebound to Pin 020 (Example: Col 4)
        , <&pro_micro 21 GPIO_ACTIVE_HIGH> // col 5
        ;
};
